JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
CLIENT_URL="http://localhost:5173"
SQL_SERVER="localhost"
SQL_PORT=1433
SQL_DATABASE="restaurant_reservations"
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# Windows Authentication:
# Leave SQL_USER and SQL_PASSWORD unset/commented out to use Trusted Connection / Integrated Security.

# SQL Server Authentication:
# Uncomment these only when connecting with a SQL login.
# SQL_USER="sa"
# SQL_PASSWORD="YourStrong!Passw0rd"

# Optional alternative to the SQL_* values above:
# MSSQL_CONNECTION_STRING="Server=localhost,1433;Database=restaurant_reservations;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=false;TrustServerCertificate=true"
# MSSQL_CONNECTION_STRING="Server=localhost,1433;Database=restaurant_reservations;Trusted_Connection=Yes;Encrypt=false;TrustServerCertificate=true"
